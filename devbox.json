{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.11.0/.schema/devbox.schema.json",
  "packages": {
    "kind":             "latest",
    "google-cloud-sdk": "latest",
    "gum":              "latest",
    "teller":           "latest",
    "stow":             "latest",
    "jq":               "latest",
    "yq-go":            "latest"
  },
  "shell": {
    "init_hook": [
      "autoload -Uz compinit",
      "compinit",
      "source <(kubectl completion zsh)"
    ],
    "scripts": {}
  }
}
